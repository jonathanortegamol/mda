<?xml version='1.0' encoding='UTF-8'?>
<ecore:EPackage xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" name="vuelos" nsURI="https://ucuenca.edu.ec/mda/vuelos/1.0" nsPrefix="vuelos">
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL" />
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="SistemaVuelos">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="AeropuertoIdentidadUnica AerolineaIdentidadUnica AvionIdentidadUnica VueloIdentidadUnica PasajeroIdentidadUnica ReservaIdentidadUnica BoletoIdentidadUnica RutasUnicas ReferenciasDentroDelSistema" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="AeropuertoIdentidadUnica" value="self.aeropuertos-&gt;isUnique(x | x.codigo)" />
      <details key="AerolineaIdentidadUnica" value="self.aerolineas-&gt;isUnique(x | x.codigo)" />
      <details key="AvionIdentidadUnica" value="self.aviones-&gt;isUnique(x | x.matricula)" />
      <details key="VueloIdentidadUnica" value="self.vuelos-&gt;isUnique(x | x.codigo)" />
      <details key="PasajeroIdentidadUnica" value="self.pasajeros-&gt;isUnique(x | x.documento)" />
      <details key="ReservaIdentidadUnica" value="self.reservas-&gt;isUnique(x | x.localizador)" />
      <details key="BoletoIdentidadUnica" value="self.boletos-&gt;isUnique(x | x.numero)" />
      <details key="RutasUnicas" value="self.rutas-&gt;forAll(a, b | a &lt;&gt; b implies (a.origen &lt;&gt; b.origen or a.destino &lt;&gt; b.destino))" />
      <details key="ReferenciasDentroDelSistema" value="self.aviones-&gt;forAll(a | self.aerolineas-&gt;includes(a.aerolinea)) and self.rutas-&gt;forAll(r | self.aeropuertos-&gt;includes(r.origen) and self.aeropuertos-&gt;includes(r.destino)) and self.vuelos-&gt;forAll(v | self.rutas-&gt;includes(v.ruta) and self.aviones-&gt;includes(v.avion)) and self.reservas-&gt;forAll(r | self.pasajeros-&gt;includes(r.pasajero) and self.vuelos-&gt;includes(r.vuelo)) and self.boletos-&gt;forAll(b | self.reservas-&gt;includes(b.reserva))" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="aeropuertos" eType="#//Aeropuerto" upperBound="-1" containment="true" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="aerolineas" eType="#//Aerolinea" upperBound="-1" containment="true" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="aviones" eType="#//Avion" upperBound="-1" containment="true" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="rutas" eType="#//Ruta" upperBound="-1" containment="true" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="vuelos" eType="#//Vuelo" upperBound="-1" containment="true" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="pasajeros" eType="#//Pasajero" upperBound="-1" containment="true" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="reservas" eType="#//Reserva" upperBound="-1" containment="true" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="boletos" eType="#//Boleto" upperBound="-1" containment="true" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Aeropuerto">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TextosNoVacios" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="TextosNoVacios" value="not self.codigo.oclIsUndefined() and self.codigo &lt;&gt; '' and not self.nombre.oclIsUndefined() and self.nombre &lt;&gt; '' and not self.ciudad.oclIsUndefined() and self.ciudad &lt;&gt; ''" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="codigo" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nombre" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ciudad" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="rutasOrigen" eType="#//Ruta" upperBound="-1" eOpposite="#//Ruta/origen" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="rutasDestino" eType="#//Ruta" upperBound="-1" eOpposite="#//Ruta/destino" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Aerolinea">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TextosNoVacios" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="TextosNoVacios" value="not self.codigo.oclIsUndefined() and self.codigo &lt;&gt; '' and not self.nombre.oclIsUndefined() and self.nombre &lt;&gt; ''" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="codigo" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nombre" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="aviones" eType="#//Avion" upperBound="-1" eOpposite="#//Avion/aerolinea" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Avion">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TextosNoVacios CapacidadPositiva" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="TextosNoVacios" value="not self.matricula.oclIsUndefined() and self.matricula &lt;&gt; ''" />
      <details key="CapacidadPositiva" value="self.capacidad &gt; 0" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="matricula" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="capacidad" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="aerolinea" eType="#//Aerolinea" lowerBound="1" eOpposite="#//Aerolinea/aviones" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="vuelos" eType="#//Vuelo" upperBound="-1" eOpposite="#//Vuelo/avion" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Ruta">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="OrigenDistintoDestino" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="OrigenDistintoDestino" value="self.origen &lt;&gt; self.destino" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="origen" eType="#//Aeropuerto" lowerBound="1" eOpposite="#//Aeropuerto/rutasOrigen" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="destino" eType="#//Aeropuerto" lowerBound="1" eOpposite="#//Aeropuerto/rutasDestino" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="vuelos" eType="#//Vuelo" upperBound="-1" eOpposite="#//Vuelo/ruta" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Vuelo">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TextosNoVacios CapacidadRespetada AsientosConfirmadosUnicos PasajerosConfirmadosUnicos" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="TextosNoVacios" value="not self.codigo.oclIsUndefined() and self.codigo &lt;&gt; ''" />
      <details key="CapacidadRespetada" value="self.reservas-&gt;select(r | r.estado = EstadoReserva::CONFIRMADA)-&gt;size() &lt;= self.avion.capacidad" />
      <details key="AsientosConfirmadosUnicos" value="self.reservas-&gt;select(r | r.estado = EstadoReserva::CONFIRMADA)-&gt;isUnique(r | r.numeroAsiento)" />
      <details key="PasajerosConfirmadosUnicos" value="self.reservas-&gt;select(r | r.estado = EstadoReserva::CONFIRMADA)-&gt;isUnique(r | r.pasajero)" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="codigo" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salida" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="llegada" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="ruta" eType="#//Ruta" lowerBound="1" eOpposite="#//Ruta/vuelos" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="avion" eType="#//Avion" lowerBound="1" eOpposite="#//Avion/vuelos" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="reservas" eType="#//Reserva" upperBound="-1" eOpposite="#//Reserva/vuelo" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Pasajero">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TextosNoVacios" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="TextosNoVacios" value="not self.documento.oclIsUndefined() and self.documento &lt;&gt; '' and not self.nombreCompleto.oclIsUndefined() and self.nombreCompleto &lt;&gt; '' and not self.contacto.oclIsUndefined() and self.contacto &lt;&gt; ''" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="documento" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nombreCompleto" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contacto" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="reservas" eType="#//Reserva" upperBound="-1" eOpposite="#//Reserva/pasajero" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Reserva">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TextosNoVacios AsientoEnRango" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="TextosNoVacios" value="not self.localizador.oclIsUndefined() and self.localizador &lt;&gt; ''" />
      <details key="AsientoEnRango" value="self.numeroAsiento &gt;= 1 and self.numeroAsiento &lt;= self.vuelo.avion.capacidad" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="localizador" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="creadaEn" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="estado" lowerBound="1" eType="#//EstadoReserva" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numeroAsiento" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="pasajero" eType="#//Pasajero" lowerBound="1" eOpposite="#//Pasajero/reservas" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="vuelo" eType="#//Vuelo" lowerBound="1" eOpposite="#//Vuelo/reservas" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="boleto" eType="#//Boleto" eOpposite="#//Boleto/reserva" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Boleto">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TextosNoVacios ReservaConfirmada" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="TextosNoVacios" value="not self.numero.oclIsUndefined() and self.numero &lt;&gt; ''" />
      <details key="ReservaConfirmada" value="self.reserva.estado = EstadoReserva::CONFIRMADA" />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numero" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="emitidoEn" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="reserva" eType="#//Reserva" lowerBound="1" eOpposite="#//Reserva/boleto" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EstadoReserva">
    <eLiterals name="CONFIRMADA" value="0" />
    <eLiterals name="CANCELADA" value="1" />
  </eClassifiers>
</ecore:EPackage>
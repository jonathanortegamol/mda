[template public reservationMethods(app : Application)]
    @Transactional
    public ReservaResponse create(ReservaRequest request) {
        Vuelo vuelo = vueloRepository.lockById(request.vueloId()).orElseThrow(() -> BusinessException.notFound("Vuelo no encontrado"));
        Pasajero pasajero = pasajeroRepository.findById(request.pasajeroId()).orElseThrow(() -> BusinessException.notFound("Pasajero no encontrado"));
        BusinessException.check(vuelo.getSalida().isAfter(OffsetDateTime.now(clock)), "RN-12", "El vuelo ya salio");
        BusinessException.check(!repository.existsByVuelo_IdAndPasajero_IdAndEstado(vuelo.getId(), pasajero.getId(), EstadoReserva.CONFIRMADA), "RN-04", "El pasajero ya tiene una reserva activa para este vuelo");
        List<Reserva> active = repository.findByVuelo_IdAndEstadoOrderByNumeroAsientoAsc(vuelo.getId(), EstadoReserva.CONFIRMADA);
        int capacity = vuelo.getAvion().getCapacidad();
        BusinessException.check(active.size() < capacity, "RN-03", "El vuelo no tiene cupos disponibles");
        Set<Integer> occupied = new HashSet<>();
        active.forEach(r -> occupied.add(r.getNumeroAsiento()));
        int seat = 1;
        while (seat <= capacity && occupied.contains(seat)) seat++;
        BusinessException.check(seat <= capacity, "RN-18", "No hay asientos disponibles");
        Reserva value = new Reserva();
        value.setLocalizador("RES-" + UUID.randomUUID().toString().toUpperCase(Locale.ROOT));
        value.setCreadaEn(OffsetDateTime.now(clock)); value.setEstado(EstadoReserva.CONFIRMADA);
        value.setNumeroAsiento(seat); value.setVuelo(vuelo); value.setPasajero(pasajero);
        return response(repository.saveAndFlush(value));
    }
    @Transactional
    public ReservaResponse cancel(Long id) {
        Long flightId = repository.findVueloIdById(id).orElseThrow(() -> BusinessException.notFound("Reserva no encontrada"));
        Vuelo vuelo = vueloRepository.lockById(flightId).orElseThrow(() -> BusinessException.notFound("Vuelo no encontrado"));
        Reserva value = repository.lockById(id).orElseThrow(() -> BusinessException.notFound("Reserva no encontrada"));
        if (value.getEstado() == EstadoReserva.CANCELADA) return response(value);
        BusinessException.check(vuelo.getSalida().isAfter(OffsetDateTime.now(clock)), "RN-12", "No se puede cancelar despues de la salida");
        BusinessException.check(boletoRepository.findByReserva_Id(id).isEmpty(), "RN-13", "No se puede cancelar una reserva con boleto");
        value.setEstado(EstadoReserva.CANCELADA);
        return response(repository.saveAndFlush(value));
    }
[/template]

[template public ticketMethods(app : Application)]
    @Transactional
    public BoletoResponse issue(Long reservaId) {
        Long flightId = reservaRepository.findVueloIdById(reservaId).orElseThrow(() -> BusinessException.notFound("Reserva no encontrada"));
        Vuelo vuelo = vueloRepository.lockById(flightId).orElseThrow(() -> BusinessException.notFound("Vuelo no encontrado"));
        Reserva reserva = reservaRepository.lockById(reservaId).orElseThrow(() -> BusinessException.notFound("Reserva no encontrada"));
        BusinessException.check(reserva.getEstado() == EstadoReserva.CONFIRMADA, "RN-07", "La reserva debe estar confirmada");
        BusinessException.check(vuelo.getSalida().isAfter(OffsetDateTime.now(clock)), "RN-12", "No se puede emitir despues de la salida");
        Optional<Boleto> existing = repository.findByReserva_Id(reservaId);
        if (existing.isPresent()) return response(existing.get());
        Boleto value = new Boleto();
        value.setNumero("BOL-" + UUID.randomUUID().toString().toUpperCase(Locale.ROOT));
        value.setEmitidoEn(OffsetDateTime.now(clock)); value.setReserva(reserva);
        return response(repository.saveAndFlush(value));
    }
[/template]


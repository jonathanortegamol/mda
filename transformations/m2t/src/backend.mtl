// Generated by Acceleo. Unit tests of observable business behavior; no database is used here.
package [app.basePackage/];
import [app.basePackage/].domain.*;
import [app.basePackage/].dto.*;
import [app.basePackage/].repository.*;
import [app.basePackage/].service.*;
import [app.basePackage/].support.*;
import java.time.*;
import java.util.*;
import org.junit.jupiter.api.*;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import static org.mockito.ArgumentMatchers.*;
class BusinessRulesTest {
    private final Clock clock = Clock.fixed(Instant.parse("2029-01-01T00:00:00Z"), ZoneOffset.UTC);
[for (e : Entity | app.entities)]
    private [e.repository.name/] [lower(e.name)/]Repository;
[/for]
    private ReservaService reservas;
    private BoletoService boletos;
    private VueloService vuelos;
    private Avion avion;
    private Vuelo vuelo;
    private Pasajero pasajero;
    private Reserva reserva;
    @BeforeEach void setup() {
[for (e : Entity | app.entities)]
        [lower(e.name)/]Repository = mock([e.repository.name/].class);
[/for]
[for (e : Entity | app.entities->select(name='Reserva' or name='Boleto' or name='Vuelo'))]
        [if (e.name='Reserva')]reservas[else][if (e.name='Boleto')]boletos[else]vuelos[/if][/if] = new [e.service.name/]([lower(e.name)/]Repository[for (d : Entity | dependencies(e,app))], [lower(d.name)/]Repository[/for], clock);
[/for]
        avion = new Avion(); avion.setId(1L); avion.setCapacidad(2);
        vuelo = new Vuelo(); vuelo.setId(1L); vuelo.setAvion(avion);
        vuelo.setSalida(OffsetDateTime.parse("2030-01-10T15:00:00Z"));
        pasajero = new Pasajero(); pasajero.setId(1L);
        reserva = new Reserva(); reserva.setId(1L); reserva.setVuelo(vuelo); reserva.setPasajero(pasajero);
        reserva.setEstado(EstadoReserva.CONFIRMADA); reserva.setNumeroAsiento(2); reserva.setLocalizador("RES-TEST");
        when(vueloRepository.lockById(1L)).thenReturn(Optional.of(vuelo));
        when(pasajeroRepository.findById(1L)).thenReturn(Optional.of(pasajero));
        when(reservaRepository.findVueloIdById(1L)).thenReturn(Optional.of(1L));
        when(reservaRepository.lockById(1L)).thenReturn(Optional.of(reserva));
        when(reservaRepository.findByVuelo_IdAndEstadoOrderByNumeroAsientoAsc(1L, EstadoReserva.CONFIRMADA)).thenReturn(List.of());
        when(reservaRepository.saveAndFlush(any())).thenAnswer(invocation -> {
            Reserva value = invocation.getArgument(0); value.setId(1L); return value;
        });
        when(boletoRepository.saveAndFlush(any())).thenAnswer(invocation -> {
            Boleto value = invocation.getArgument(0); value.setId(1L); return value;
        });
    }
    @Test void assignsFirstSeatOnEmptyFlight() {
        ReservaResponse result = reservas.create(new ReservaRequest(1L,1L));
        assertEquals(1,result.numeroAsiento()); assertEquals(EstadoReserva.CONFIRMADA,result.estado());
        var order = inOrder(vueloRepository,reservaRepository);
        order.verify(vueloRepository).lockById(1L);
        order.verify(reservaRepository).existsByVuelo_IdAndPasajero_IdAndEstado(1L,1L,EstadoReserva.CONFIRMADA);
    }
    @Test void reusesLowestGapInsteadOfCountingReservations() {
        avion.setCapacidad(3);
        Reserva one=new Reserva();one.setNumeroAsiento(1);
        Reserva three=new Reserva();three.setNumeroAsiento(3);
        when(reservaRepository.findByVuelo_IdAndEstadoOrderByNumeroAsientoAsc(1L,EstadoReserva.CONFIRMADA)).thenReturn(List.of(one,three));
        assertEquals(2,reservas.create(new ReservaRequest(1L,1L)).numeroAsiento());
    }
    @Test void rejectsFullFlightWithoutSaving() {
        when(reservaRepository.findByVuelo_IdAndEstadoOrderByNumeroAsientoAsc(1L,EstadoReserva.CONFIRMADA)).thenReturn(List.of(new Reserva(),new Reserva()));
        assertEquals("RN-03",assertThrows(BusinessException.class,() -> reservas.create(new ReservaRequest(1L,1L))).rule());
        verify(reservaRepository,never()).saveAndFlush(any());
    }
    @Test void rejectsDuplicateActivePassenger() {
        when(reservaRepository.existsByVuelo_IdAndPasajero_IdAndEstado(1L,1L,EstadoReserva.CONFIRMADA)).thenReturn(true);
        assertEquals("RN-04",assertThrows(BusinessException.class,() -> reservas.create(new ReservaRequest(1L,1L))).rule());
        verify(reservaRepository,never()).saveAndFlush(any());
    }
    @Test void rejectsReservationAtDeparture() {
        vuelo.setSalida(OffsetDateTime.now(clock));
        assertEquals("RN-12",assertThrows(BusinessException.class,() -> reservas.create(new ReservaRequest(1L,1L))).rule());
    }
    @Test void cancellationPreservesHistoricalSeat() {
        ReservaResponse result=reservas.cancel(1L);
        assertEquals(EstadoReserva.CANCELADA,result.estado());assertEquals(2,result.numeroAsiento());
        var order=inOrder(vueloRepository,reservaRepository);
        order.verify(reservaRepository).findVueloIdById(1L);
        order.verify(vueloRepository).lockById(1L);
        order.verify(reservaRepository).lockById(1L);
    }
    @Test void cancellationWithTicketIsRejected() {
        when(boletoRepository.findByReserva_Id(1L)).thenReturn(Optional.of(new Boleto()));
        assertEquals("RN-13",assertThrows(BusinessException.class,() -> reservas.cancel(1L)).rule());
        assertEquals(EstadoReserva.CONFIRMADA,reserva.getEstado());verify(reservaRepository,never()).saveAndFlush(any());
    }
    @Test void repeatedCancellationDoesNotSaveAgain() {
        reserva.setEstado(EstadoReserva.CANCELADA);
        assertEquals(EstadoReserva.CANCELADA,reservas.cancel(1L).estado());verify(reservaRepository,never()).saveAndFlush(any());
    }
    @Test void issueReturnsExistingTicketAndSeat() {
        Boleto ticket=new Boleto();ticket.setId(7L);ticket.setNumero("BOL-TEST");ticket.setReserva(reserva);
        when(boletoRepository.findByReserva_Id(1L)).thenReturn(Optional.of(ticket));
        BoletoResponse result=boletos.issue(1L);
        assertEquals(7L,result.id());assertEquals(2,result.numeroAsiento());verify(boletoRepository,never()).saveAndFlush(any());
    }
    @Test void issueRejectsCancelledReservation() {
        reserva.setEstado(EstadoReserva.CANCELADA);
        assertEquals("RN-07",assertThrows(BusinessException.class,() -> boletos.issue(1L)).rule());verify(boletoRepository,never()).saveAndFlush(any());
    }
    @Test void newTicketDoesNotChangeSeatOrReservationState() {
        BoletoResponse result=boletos.issue(1L);
        assertEquals(2,result.numeroAsiento());assertEquals(EstadoReserva.CONFIRMADA,reserva.getEstado());
        verify(reservaRepository,never()).saveAndFlush(any());
    }
    @Test void rejectsOverlappingFlightAfterLockingAircraft() {
        when(avionRepository.lockById(1L)).thenReturn(Optional.of(avion));
        Ruta route=new Ruta();route.setId(1L);when(rutaRepository.findById(1L)).thenReturn(Optional.of(route));
        OffsetDateTime departure=OffsetDateTime.parse("2030-01-10T15:00:00Z"),arrival=departure.plusHours(1);
        when(vueloRepository.existsOverlap(1L,departure,arrival)).thenReturn(true);
        assertEquals("RN-08",assertThrows(BusinessException.class,() -> vuelos.create(new VueloRequest("DEMO-2",departure,arrival,1L,1L))).rule());
        verify(vueloRepository,never()).saveAndFlush(any());
        var order=inOrder(avionRepository,vueloRepository);order.verify(avionRepository).lockById(1L);order.verify(vueloRepository).existsOverlap(1L,departure,arrival);
    }
}
[/file]

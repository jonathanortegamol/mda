[query public javaDir(app : Application) : String = 'src/main/java/' + app.basePackage.substituteAll('.', '/') /]
[query public lower(s : String) : String = s.substring(1,1).toLower() + s.substring(2,s.size()) /]
[query public javaType(a : Attribute) : String =
    if a.javaType = JavaType::STRING then 'String' else
    if a.javaType = JavaType::INTEGER then 'Integer' else
    if a.javaType = JavaType::LONG then 'Long' else
    if a.javaType = JavaType::OFFSET_DATE_TIME then 'OffsetDateTime' else a.enumType.name endif endif endif endif /]
[query public owners(e : Entity) : Sequence(Association) = e.associations->select(owning)->asSequence() /]
[query public dependencies(e : Entity, app : Application) : OrderedSet(Entity) =
    owners(e).target->asOrderedSet()->union(
    if e.sourceClass = 'Vuelo' then app.entities->select(name='Reserva')->asOrderedSet() else
    if e.sourceClass = 'Reserva' then app.entities->select(name='Boleto')->asOrderedSet() else
    if e.sourceClass = 'Boleto' then app.entities->select(name='Vuelo')->asOrderedSet() else OrderedSet{} endif endif endif) /]
[query public timed(e : Entity) : Boolean = e.service.policies->exists(p | p.kind = PolicyKind::TEMPORAL or p.kind = PolicyKind::ALLOCATE_SEAT or p.kind = PolicyKind::ISSUE_TICKET) /]
[query public entityPath(app : Application, e : Entity, folder : String, suffix : String) : String = javaDir(app) + '/' + folder + '/' + e.name + suffix + '.java' /]


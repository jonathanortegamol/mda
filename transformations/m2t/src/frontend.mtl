[comment encoding = UTF-8 /]
[module frontend('platform:/resource/ec.edu.ucuenca.mda.vuelos.modeling/metamodels/spring-psm.ecore')/]
[template public generate(app : Application)]
[comment @main /]
[file ('index.html', false, 'UTF-8')]
<!doctype html>
<!-- Generated by Acceleo from the PSM. Edit frontend.mtl. -->
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aero · Gestión de vuelos</title><link rel="stylesheet" href="styles.css"><script defer src="model.js"></script><script defer src="demo-store.js"></script><script defer src="app.js"></script></head>
<body><div class="shell"><aside class="sidebar"><a class="brand" href="#resumen"><span class="brand-mark">↗</span><span>aero<span class="blue">.</span><small>GESTIÓN DE VUELOS</small></span></a><p class="nav-caption">ESPACIO DE TRABAJO</p><nav id="navigation" aria-label="Navegación principal"><button data-view="resumen"><i>◫</i><span>Resumen</span></button><button data-view="vuelos"><i>↗</i><span>Vuelos</span></button><button data-view="pasajeros"><i>♙</i><span>Pasajeros</span></button><button data-view="reservas"><i>▤</i><span>Reservas</span></button><button data-view="boletos"><i>▱</i><span>Boletos</span></button><hr><button data-view="catalogos"><i>▦</i><span>Catálogos</span></button></nav><div class="sidebar-bottom"><div>✈</div><strong>Todo listo para despegar</strong><p>De la programación al boleto,<br>en un mismo lugar.</p><small>Proyecto académico · UCuenca</small></div></aside><div class="main-shell"><header class="topbar"><span class="breadcrumb">Operaciones <b>/</b> <span id="crumb">Resumen</span></span><div><button class="mode-button" id="connection"><span class="status-dot"></span><span id="mode-label">Demostración local</span><span>⌄</span></button><span class="avatar">OP</span></div></header><main id="workspace"></main><footer><span>Aero · Sistema de Gestión de Vuelos</span><span id="storage-label">Datos ficticios en este navegador</span></footer></div></div>
<dialog id="editor" aria-labelledby="dialog-title"><header class="dialog-heading"><div><span class="eyebrow" id="dialog-eyebrow">NUEVO REGISTRO</span><h2 id="dialog-title">Registrar</h2></div><button class="icon-button" id="close-editor" aria-label="Cerrar formulario">×</button></header><div id="dialog-body"></div></dialog>
<dialog id="settings" aria-labelledby="settings-title"><header class="dialog-heading"><div><span class="eyebrow">TU ENTORNO</span><h2 id="settings-title">Origen de los datos</h2></div><button class="icon-button" data-close-settings aria-label="Cerrar conexión">×</button></header><form id="settings-form"><p class="muted">Recorre las pantallas sin instalar una base de datos.</p><label class="mode-choice"><input type="radio" name="mode" value="demo"><span><strong>Demostración local</strong><small>Datos ficticios y operaciones en este navegador.</small></span></label><label class="mode-choice"><input type="radio" name="mode" value="api"><span><strong>Conectar al backend</strong><small>Usar la API real y su persistencia.</small></span></label><label class="field">Dirección de la API<input name="apiBase" placeholder="/api"><small>Con la vista previa local puedes usar /api.</small></label><p class="form-error" role="alert" hidden></p><div class="dialog-actions"><button type="button" class="button secondary" data-close-settings>Cancelar</button><button class="button primary" type="submit">Aplicar conexión</button></div></form><div class="reset-area"><button class="text-button" id="reset-demo">Restablecer datos de demostración</button><small>Solo afecta a los datos locales de esta interfaz.</small></div></dialog>
<div id="toast" role="status" aria-live="polite" hidden></div>

[for (e : Entity | app.entities)]
<template id="form-[e.name/]"><form class="entity-form" data-entity="[e.name/]"><div class="form-grid">
[if (e.sourceClass <> 'Reserva' and e.sourceClass <> 'Boleto')]
[for (a : Attribute | e.attributes->reject(primaryKey))]
<label class="field" for="field-[e.name/]-[a.name/]"><span>[label(a.name)/][if (not a.nullable)] <b aria-hidden="true">*</b>[/if]</span>
[if (a.javaType = JavaType::ENUM)]
<select id="field-[e.name/]-[a.name/]" name="[a.name/]"[if (not a.nullable)] required[/if]><option value="">Selecciona una opción</option>[for (l : EnumLiteral | a.enumType.literals)]<option value="[l.name/]">[l.name/]</option>[/for]</select>
[else]
<input id="field-[e.name/]-[a.name/]" name="[a.name/]" type="[inputType(a)/]"[if (not a.nullable)] required[/if][if (a.positive)] min="1"[/if][if (a.length > 0)] maxlength="[a.length/]"[/if][if (a.javaType = JavaType::INTEGER or a.javaType = JavaType::LONG)] step="1"[/if] autocomplete="off" placeholder="[label(a.name)/]">
[/if]
</label>
[/for]
[/if]
[for (r : Association | e.associations->select(owning))]
<label class="field" for="field-[e.name/]-[r.name/]Id"><span>[label(r.name)/][if (r.lower > 0)] <b aria-hidden="true">*</b>[/if]</span><select id="field-[e.name/]-[r.name/]Id" name="[r.name/]Id" data-reference="[r.target.name/]"[if (r.lower > 0)] required[/if]><option value="">Selecciona una opción</option></select></label>
[/for]
</div><div class="form-context" hidden></div><p class="form-error" role="alert" hidden></p><div class="form-footer"><span></span><div><button type="button" class="button secondary" data-cancel>Cancelar</button><button type="submit" class="button primary" data-submit>Guardar</button></div></div></form></template>
[/for]

</body></html>

[/file]

[file ('model.js', false, 'UTF-8')]
// Generated by Acceleo from the ATL PSM. Field definitions come from the model.
globalThis.FlightModel = {
 name: '[app.name/]', namespace: '[app.sourcePimNsURI/]', entities: ['['/]
[for (e : Entity | app.entities) separator(',')]
 {name:'[e.name/]', table:'[e.tableName/]', path:'[e.controller.basePath/]', fields:['['/]
[for (a : Attribute | e.attributes) separator(',')]
 {name:'[a.name/]',column:'[a.columnName/]',label:'[label(a.name)/]',type:'[a.javaType/]',required:[not a.nullable/],primaryKey:[a.primaryKey/],positive:[a.positive/],length:[a.length/],values:['['/][if (a.javaType = JavaType::ENUM)][for (l : EnumLiteral | a.enumType.literals) separator(',')]'[l.name/]'[/for][/if][']'/]}
[/for]
 [']'/],relations:['['/]
[for (r : Association | e.associations->select(owning)) separator(',')]
 {name:'[r.name/]',label:'[label(r.name)/]',target:'[r.target.name/]',required:[r.lower > 0/]}
[/for]
 [']'/],uniqueFields:['['/]
[for (c : SqlConstraint | e.constraints->select(kind=ConstraintKind::UNIQUE and columns->size()=1))]
[for (a : Attribute | e.attributes->select(columnName=c.columns->first())) separator(',')]'[a.name/]'[/for]
[/for]
 [']'/],operations:['['/]
[for (op : Operation | e.controller.operations) separator(',')]
 {kind:'[op.kind/]',method:'[op.httpMethod/]',path:'[op.path/]'}
[/for]
 [']'/]}
[/for]
 [']'/]
};
[/file]
[file ('styles.css', false, 'UTF-8')]
/* Generated by Acceleo. Visual scaffold is defined in frontend.mtl. */
:root{--ink:#172d42;--muted:#748497;--blue:#355fe9;--line:#e5ebf2;--bg:#f5f7fb;font-family:"Segoe UI",Arial,sans-serif;color:var(--ink)}*{box-sizing:border-box}body{margin:0;background:var(--bg);font-size:14px}button,input,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,a:focus-visible{outline:3px solid #9cb3ff;outline-offset:3px}.shell{display:flex;min-height:100vh}.sidebar{width:232px;position:fixed;inset:0 auto 0 0;background:#fff;border-right:1px solid var(--line);padding:35px 20px 24px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:12px;font-size:35px;font-weight:750;letter-spacing:-1.6px;text-decoration:none;color:var(--ink);margin:0 8px 42px}.brand-mark{display:grid;place-items:center;width:41px;height:43px;background:var(--blue);color:white;border-radius:12px;font-size:30px;font-weight:400}.blue{color:var(--blue)}.brand small{display:block;font-size:8px;letter-spacing:1.8px;color:var(--muted);margin-top:1px}.nav-caption{font-size:9px;letter-spacing:1.6px;color:#93a0ae;font-weight:700;margin:0 13px 16px}nav{display:flex;flex-direction:column;gap:7px}nav button{display:flex;align-items:center;gap:13px;border:0;background:none;color:#748397;text-align:left;border-radius:9px;padding:13px 14px;font-size:12px;font-weight:600}nav button:hover{background:#f7f9fc}nav button.active{background:#edf1ff;color:var(--blue)}nav i{font-style:normal;width:22px;text-align:center;font-size:20px}nav hr{border:0;border-top:1px solid var(--line);margin:15px 8px}.sidebar-bottom{margin-top:auto;padding:35px 12px 0}.sidebar-bottom>div{font-size:30px;color:#a6b6cd;margin-bottom:13px}.sidebar-bottom strong{font-size:11px}.sidebar-bottom p{font-size:11px;line-height:1.9;color:#929fad}.sidebar-bottom small{display:block;border-top:1px solid var(--line);padding-top:20px;margin-top:28px;font-size:9px;color:#9ba6b2}.main-shell{margin-left:232px;width:calc(100% - 232px);min-width:0}.topbar{height:80px;background:#ffffffd9;border-bottom:1px solid var(--line);padding:0 40px;display:flex;align-items:center;justify-content:space-between}.topbar>div{display:flex;gap:23px;align-items:center}.breadcrumb{font-size:12px;color:#8290a0}.breadcrumb b{font-weight:400;margin:0 13px;color:#ccd3db}.mode-button{display:flex;gap:9px;align-items:center;padding:9px 13px;border:1px solid var(--line);border-radius:25px;background:white;color:#68798c;font-size:11px}.status-dot{height:6px;width:6px;background:#2fa887;border-radius:50%}.avatar{display:grid;place-items:center;width:33px;height:33px;background:#eaf0f9;border-radius:50%;font-size:10px;color:#6d83a0;font-weight:700}main{max-width:1550px;padding:37px 40px 26px;margin:auto;min-height:calc(100vh - 143px)}.page-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:29px}.eyebrow{font-size:9px;letter-spacing:1.6px;font-weight:700;color:#96a2b0}h1{font-size:29px;letter-spacing:-.9px;font-weight:650;margin:7px 0 8px}h2{font-size:24px;letter-spacing:-.6px;margin:7px 0;font-weight:650}h3{font-size:15px;font-weight:650;margin:0}.muted,.page-heading p{font-size:12px;line-height:1.8;color:var(--muted);margin:0}.button{display:inline-flex;gap:8px;justify-content:center;align-items:center;border:1px solid transparent;border-radius:8px;padding:11px 16px;font-size:12px;font-weight:600;white-space:nowrap}.primary{background:var(--blue);color:white;box-shadow:0 3px 9px #355fe915}.primary:hover{background:#244dd2}.secondary{background:#fff;color:#5a6e85;border-color:#dfe6ef}.secondary:hover{background:#f4f7fc}.small{padding:8px 11px;font-size:10px}.text-button{border:0;background:none;padding:0;color:var(--blue);font-size:11px}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px;margin-bottom:27px}.metric{background:white;border:1px solid var(--line);border-radius:14px;padding:20px 22px}.metric-top{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--muted);gap:5px}.metric-icon{display:grid;place-items:center;width:32px;height:32px;border-radius:9px;background:#f0f3ff;color:#6a83d4;font-size:19px}.metric-value{font-size:30px;font-weight:650;line-height:1;letter-spacing:-.8px;margin:15px 0 11px}.metric-bottom{font-size:10px;color:#9aa6b3}.metric-bottom b{color:#3a9578;font-weight:600}.content-grid{display:grid;grid-template-columns:minmax(0,1fr) 276px;gap:22px}.panel{background:white;border:1px solid var(--line);border-radius:14px;overflow:hidden}.panel-heading{padding:23px;display:flex;justify-content:space-between;align-items:center;gap:8px}.panel-heading p{color:#9aa6b3;font-size:11px;margin:5px 0 0}.panel-heading .text-button{font-size:10px}.route-card{background:#183149;color:white;border-radius:14px;padding:23px;margin-bottom:20px;position:relative;overflow:hidden}.route-card:after{content:"";position:absolute;right:-130px;top:-65px;width:240px;height:240px;border:1px solid #ffffff0c;border-radius:50%;box-shadow:0 0 0 30px #ffffff03,0 0 0 65px #ffffff02}.flight-caption{display:flex;justify-content:space-between;font-size:10px;margin-bottom:32px}.flight-caption small{color:#94b0ca}.route-visual{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}.airport-code{font-size:28px;letter-spacing:1px;font-weight:600}.airport-city{font-size:10px;color:#9ab5cb;margin-top:6px}.route-dashes{flex:1;border-top:1px dashed #6f90ab;text-align:center;margin:0 14px;position:relative}.route-dashes span{position:absolute;top:-11px;left:calc(50% - 9px);font-size:18px;background:#183149;color:#b4c9db;padding:0 3px}.route-time{display:flex;justify-content:space-between;border-top:1px solid #ffffff1a;padding-top:18px;margin-top:28px;font-size:13px}.route-time small{color:#8eacc4;font-size:9px}.route-card .button{margin-top:23px;width:100%;background:#ffffff10;border-color:#ffffff1c;color:#fff;position:relative;z-index:1}.activity{padding:23px}.activity h3{margin-bottom:24px}.activity-item{display:flex;gap:11px;padding-bottom:22px;font-size:11px}.activity-item:last-child{padding-bottom:0}.activity-dot{display:grid;place-items:center;width:19px;height:19px;background:#eff4ff;border-radius:50%;color:#7490d3;flex-shrink:0}.activity-item p{margin:0 0 5px;font-weight:600}.activity-item small{color:#99a6b4;font-size:10px;line-height:1.8}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:11px;white-space:nowrap}thead{background:#f9fafc;color:#94a0af}th{font-weight:500;text-align:left;padding:12px 19px;border-bottom:1px solid var(--line);font-size:10px}td{padding:19px;border-bottom:1px solid #eef2f6;color:#5b6d80}tbody tr:last-child td{border-bottom:0}tbody tr:hover{background:#fcfdff}.cell-primary{color:#294158;font-weight:650;font-size:12px}.cell-sub{display:block;color:#9ca8b5;margin-top:5px;font-size:9px}.flight-cell{display:flex;align-items:center;gap:10px}.plane-mini{display:grid;place-items:center;width:29px;height:29px;border-radius:8px;background:#eff4fc;color:#8098b9;font-size:16px}.route-inline{font-size:12px;font-weight:600;color:#49657f}.route-arrow{color:#b0bed0;font-weight:400;margin:0 9px}.pill{display:inline-flex;align-items:center;gap:5px;font-size:9px;font-weight:600;padding:5px 8px;background:#edf8f2;color:#429578;border-radius:5px}.pill:before{content:"";width:4px;height:4px;background:currentColor;border-radius:50%}.pill.gray{background:#f0f3f6;color:#909ead}.seat-chip{display:inline-grid;place-items:center;min-width:29px;height:26px;border:1px solid #e1e8f4;background:#f1f5fc;border-radius:6px;font-weight:650;color:#5c7799}.table-footer{padding:15px 23px;border-top:1px solid var(--line);display:flex;justify-content:space-between;font-size:9px;color:#9ba7b4}.toolbar{display:flex;align-items:center;gap:11px;padding:17px 21px;border-bottom:1px solid var(--line);flex-wrap:wrap}.search-wrap{display:flex;gap:9px;align-items:center;flex:1;min-width:180px;border:1px solid var(--line);padding:0 12px;border-radius:7px;color:#a2afbd}.search-wrap input{width:100%;border:0;outline:0;padding:11px 0;font-size:11px}.filter-select{padding:10px;border:1px solid var(--line);border-radius:7px;background:white;color:#6e8093;font-size:11px;max-width:170px}.segmented{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:20px}.segmented button{border:1px solid var(--line);border-radius:7px;background:white;color:#8290a0;padding:9px 13px;font-size:11px}.segmented .selected{color:var(--blue);background:#eef2ff;border-color:#d5dfff}.empty{text-align:center;padding:40px 22px}.empty p{color:var(--muted);font-size:12px;line-height:1.8}.empty-icon{font-size:30px;color:#a9bad0;margin-bottom:12px}footer{display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line);padding:20px 0;margin:0 40px;font-size:9px;color:#9ca7b3}.error-panel{padding:25px;background:#fff9f8;color:#a2524c;border:1px solid #efd0cd;border-radius:12px}dialog{width:calc(100% - 40px);max-width:720px;max-height:90vh;overflow:auto;border:0;border-radius:17px;padding:27px;color:var(--ink);box-shadow:0 25px 110px #162f4655}dialog::backdrop{background:#19324866;backdrop-filter:blur(3px)}.dialog-heading{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}.icon-button{width:31px;height:31px;border:0;border-radius:7px;font-size:23px;line-height:1;background:#f2f5fa;color:#8799af}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.field{display:flex;flex-direction:column;gap:8px;font-size:11px;color:#6f8195}.field b{color:#6b8ae0;font-weight:400}.field input,.field select{width:100%;min-width:0;border:1px solid #dce4ee;border-radius:8px;padding:12px;font-size:12px;color:#284159;background:white;outline-color:var(--blue)}.field input::placeholder{color:#b6c1ce}.field small{font-size:10px;line-height:1.7;color:#9ba6b3}.form-footer{border-top:1px solid var(--line);padding-top:21px;margin-top:27px;display:flex;justify-content:space-between;align-items:center;gap:14px}.form-footer>span{font-size:9px;color:#9ca8b5}.form-footer>div{display:flex;gap:9px}.form-context{background:#f2f6ff;color:#5a78a3;border:1px solid #e0e9fb;border-radius:8px;padding:13px 15px;margin-top:20px;font-size:11px;line-height:1.8}.form-error{background:#fff0f0;color:#ab4747;border-radius:7px;padding:12px;font-size:12px;line-height:1.6}.dialog-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:25px}.mode-choice{display:flex;gap:11px;align-items:flex-start;padding:17px 0;font-size:12px}.mode-choice input{accent-color:var(--blue);margin-top:3px}.mode-choice small{display:block;color:#98a6b4;font-size:11px;margin-top:6px}.reset-area{border-top:1px solid var(--line);padding-top:19px;margin-top:24px}.reset-area small{display:block;color:#9aa7b5;font-size:10px;margin-top:9px}#toast{position:fixed;bottom:25px;right:25px;max-width:calc(100% - 40px);padding:16px 22px;background:#204b40;color:white;border-radius:10px;font-size:12px;box-shadow:0 5px 30px #19354722;z-index:20}#toast.error{background:#934843}.ticket{border:1px solid #dce4ef;border-radius:12px;overflow:hidden}.ticket-top{background:var(--ink);color:white;padding:20px;display:flex;justify-content:space-between;font-size:12px}.ticket-body{padding:25px}.ticket-route{display:flex;justify-content:space-between;align-items:center;font-size:28px;font-weight:650;padding-bottom:24px;border-bottom:1px dashed #d8e1eb;margin-bottom:24px}.ticket-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.ticket-grid small{display:block;font-size:9px;color:#94a4b5;margin-bottom:7px}.ticket-grid strong{font-size:12px;font-weight:600}.ticket-foot{margin-top:25px;color:#95a3b2;font-size:10px;line-height:1.7}
@media(max-width:1150px){.sidebar{width:200px;padding-left:12px;padding-right:12px}.main-shell{margin-left:200px;width:calc(100% - 200px)}main{padding:29px 25px}.topbar{padding:0 25px}.content-grid{grid-template-columns:minmax(0,1fr)}.right-rail{display:grid;grid-template-columns:1fr 1fr;gap:20px}.route-card{margin:0}.metrics{gap:12px}.metric{padding:18px}footer{margin:0 25px}}
@media(max-width:760px){.sidebar{width:73px;padding:25px 8px}.brand{margin:0 auto 35px}.brand>span:last-child,.nav-caption,nav button>span,.sidebar-bottom{display:none}nav button{justify-content:center;padding:14px 8px}nav i{font-size:23px}.main-shell{margin-left:73px;width:calc(100% - 73px)}.topbar{height:67px;padding:0 20px}.avatar{display:none}.breadcrumb{font-size:10px}.mode-button{font-size:10px}.metrics{grid-template-columns:1fr 1fr}main{padding:25px 20px}h1{font-size:25px}.page-heading{align-items:flex-start}.page-heading>.button{font-size:11px}footer{margin:0 20px;line-height:1.7}footer>span:last-child{text-align:right;max-width:150px}}
@media(max-width:500px){.sidebar{width:60px;padding:25px 5px}.main-shell{margin-left:60px;width:calc(100% - 60px)}.brand-mark{width:34px;height:36px}.breadcrumb{display:none}.topbar{justify-content:flex-end}.page-heading{flex-direction:column;gap:16px}h1{font-size:24px}.metrics{gap:9px}.metric{padding:15px}.metric-top{font-size:10px}.metric-icon{width:25px;height:25px}.metric-value{font-size:27px}.right-rail{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.form-footer{flex-direction:column;align-items:flex-end}.form-footer>span{align-self:flex-start}dialog{padding:22px;width:calc(100% - 24px)}.toolbar{padding:14px}.filter-select{max-width:100%;flex:1}footer>span:last-child{display:none}}
.table-scroll td:last-child{position:sticky;right:0;background:white;box-shadow:-6px 0 8px -6px #d4deea}.table-scroll th:last-child{position:sticky;right:0;background:#f9fafc}
@media print{#settings{display:none!important}.shell,.dialog-actions,.dialog-heading,#toast{display:none}dialog{display:block;position:static;box-shadow:none;width:100%;max-width:none;border:0}.ticket{max-width:650px;margin:30px auto}.ticket-top{background:white;color:#172d42;border-bottom:1px solid #ddd}}

[/file]
[file ('demo-store.js', false, 'UTF-8')]
/* Generated by Acceleo. Browser demo adapter; not execution of Spring Boot or PostgreSQL. */
(function(g){'use strict';
class FlightDemo {
 constructor(model,options={}){this.model=model;this.clock=options.clock||(()=>new Date());this.key=options.key||'aero.flight.demo.v1';this.storage=options.storage||null;this.persistent=false;try{if(this.storage){this.storage.setItem(this.key+'.probe','1');this.storage.removeItem(this.key+'.probe');this.persistent=true;}}catch(e){this.storage=null;}let saved=null;try{saved=JSON.parse(this.storage?.getItem(this.key)||'null');}catch(e){}this.db=saved&&model.entities.every(e=>Array.isArray(saved['['/]e.name[']'/]))?saved:this.blank();if(!saved&&options.seed!==false)this.seed();this.completeFields();this.save();}
 blank(){return Object.fromEntries(this.model.entities.map(e=>['['/]e.name,['['/][']'/][']'/]));}
 spec(t){const e=this.model.entities.find(e=>e.name===t);if(!e)throw Error('Tipo de registro no reconocido');return e;}
 completeFields(){for(const e of this.model.entities)for(const r of this.db['['/]e.name[']'/])for(const f of e.fields)if(!(f.name in r)&&!f.primaryKey)r['['/]f.name[']'/]=f.required?(f.type==='STRING'?'Dato de ejemplo':null):null;}
 save(){if(this.storage)try{this.storage.setItem(this.key,JSON.stringify(this.db));}catch(e){this.storage=null;this.persistent=false;}}
 raw(t,id){const r=this.db['['/]t[']'/].find(r=>r.id===Number(id));if(!r)throw Error('No se encontró el registro seleccionado');return r;}
 confirmed(id){return this.db.Reserva.filter(r=>r.vueloId===Number(id)&&r.estado==='CONFIRMADA');}
 decorate(t,row){const r={...row};if(t==='Vuelo'){const route=this.raw('Ruta',r.rutaId),plane=this.raw('Avion',r.avionId);Object.assign(r,{origenId:route.origenId,destinoId:route.destinoId,aerolineaId:plane.aerolineaId,cuposDisponibles:plane.capacidad-this.confirmed(r.id).length});}if(t==='Reserva')r.boletoId=this.db.Boleto.find(b=>b.reservaId===r.id)?.id||null;if(t==='Boleto')r.numeroAsiento=this.raw('Reserva',r.reservaId).numeroAsiento;return r;}
 all(t){return this.db['['/]t[']'/].map(r=>this.decorate(t,r));}get(t,id){return this.decorate(t,this.raw(t,id));}
 available(){return this.all('Vuelo').filter(v=>new Date(v.salida)>this.clock()&&v.cuposDisponibles>0).sort((a,b)=>new Date(a.salida)-new Date(b.salida));}
 insert(t,row){const r={...row,id:Math.max(0,...this.db['['/]t[']'/].map(x=>x.id))+1};this.db['['/]t[']'/].push(r);this.save();return this.decorate(t,r);}
 create(t,input){if(t==='Reserva')return this.reserve(input);if(t==='Boleto')return this.issue(input.reservaId);const spec=this.spec(t),r={};for(const f of spec.fields.filter(f=>!f.primaryKey)){let v=input['['/]f.name[']'/];if(v===''||v===undefined)v=null;if(f.required&&(v===null||(typeof v==='string'&&!v.trim())))throw Error(f.label+': completa este campo');if(v!==null){if(f.type==='INTEGER'||f.type==='LONG'){v=Number(v);if(!Number.isInteger(v))throw Error(f.label+': usa un número entero');if(f.positive&&v<=0)throw Error(f.label+': debe ser mayor que cero');}else if(f.type==='OFFSET_DATE_TIME'){if(!Number.isFinite(Date.parse(v)))throw Error(f.label+': fecha inválida');v=new Date(v).toISOString();}else if(f.type==='ENUM'){if(!f.values.includes(v))throw Error(f.label+': opción inválida');}else{v=String(v).trim();if(['['/]'codigo','matricula','documento'[']'/].includes(f.name))v=v.toUpperCase();if(f.length&&v.length>f.length)throw Error(f.label+': longitud máxima superada');}}r['['/]f.name[']'/]=v;}for(const ref of spec.relations){const id=Number(input['['/]ref.name+'Id'[']'/]);if(!id&&ref.required)throw Error('Selecciona '+ref.label.toLowerCase());if(id)this.raw(ref.target,id);r['['/]ref.name+'Id'[']'/]=id||null;}for(const field of spec.uniqueFields)if(this.db['['/]t[']'/].some(x=>x['['/]field[']'/]===r['['/]field[']'/]))throw Error('Ya existe un registro con ese '+(spec.fields.find(f=>f.name===field)?.label||field).toLowerCase());
 if(t==='Ruta'){if(r.origenId===r.destinoId)throw Error('El origen y el destino deben ser diferentes');if(this.db.Ruta.some(x=>x.origenId===r.origenId&&x.destinoId===r.destinoId))throw Error('Esta ruta ya está registrada');}
 if(t==='Vuelo'){const start=new Date(r.salida),end=new Date(r.llegada);if(start<=this.clock())throw Error('La salida debe ser futura');if(end<=start)throw Error('La llegada debe ser posterior a la salida');if(this.db.Vuelo.some(v=>v.avionId===r.avionId&&new Date(v.salida)<end&&start<new Date(v.llegada)))throw Error('El avión tiene otro vuelo con un horario incompatible');}return this.insert(t,r);}
 reserve(input){const v=this.get('Vuelo',input.vueloId),p=this.raw('Pasajero',input.pasajeroId);if(new Date(v.salida)<=this.clock())throw Error('El vuelo ya salió');const active=this.confirmed(v.id);if(active.some(r=>r.pasajeroId===p.id))throw Error('El pasajero ya tiene una reserva activa para este vuelo');const cap=this.raw('Avion',v.avionId).capacidad;if(active.length>=cap)throw Error('El vuelo no tiene cupos disponibles');const used=new Set(active.map(r=>r.numeroAsiento));let seat=1;while(used.has(seat)&&seat<=cap)seat++;if(seat>cap)throw Error('No hay asientos disponibles');return this.insert('Reserva',{localizador:this.code('RES'),creadaEn:this.clock().toISOString(),estado:'CONFIRMADA',numeroAsiento:seat,pasajeroId:p.id,vueloId:v.id});}
 cancel(id){const r=this.raw('Reserva',id);if(r.estado==='CANCELADA')return this.decorate('Reserva',r);if(new Date(this.raw('Vuelo',r.vueloId).salida)<=this.clock())throw Error('No se puede cancelar después de la salida');if(this.db.Boleto.some(b=>b.reservaId===r.id))throw Error('Esta reserva ya tiene un boleto; no puede cancelarse');r.estado='CANCELADA';this.save();return this.decorate('Reserva',r);}
 issue(id){const r=this.raw('Reserva',id);if(r.estado!=='CONFIRMADA')throw Error('La reserva debe estar confirmada');if(new Date(this.raw('Vuelo',r.vueloId).salida)<=this.clock())throw Error('No se puede emitir después de la salida');const existing=this.db.Boleto.find(b=>b.reservaId===r.id);return existing?this.decorate('Boleto',existing):this.insert('Boleto',{numero:this.code('BOL'),emitidoEn:this.clock().toISOString(),reservaId:r.id});}
 code(p){return p+'-'+this.clock().getTime().toString(36).toUpperCase()+'-'+Math.random().toString(36).slice(2,7).toUpperCase();}
 reset(){this.db=this.blank();this.seed();this.completeFields();this.save();}
 seed(){const day=(n,h)=>{const d=new Date(this.clock());d.setDate(d.getDate()+n);d.setHours(h,0,0,0);return d.toISOString();};Object.assign(this.db,{
 Aeropuerto:['['/]{id:1,codigo:'CUE',nombre:'Aeropuerto de Cuenca',ciudad:'Cuenca'},{id:2,codigo:'UIO',nombre:'Aeropuerto de Quito',ciudad:'Quito'},{id:3,codigo:'GYE',nombre:'Aeropuerto de Guayaquil',ciudad:'Guayaquil'}[']'/],Aerolinea:['['/]{id:1,codigo:'AND',nombre:'Andes Air'},{id:2,codigo:'SIE',nombre:'Sierra Air'}[']'/],Avion:['['/]{id:1,matricula:'HC-DEMO1',capacidad:12,aerolineaId:1},{id:2,matricula:'HC-DEMO2',capacidad:8,aerolineaId:2}[']'/],Ruta:['['/]{id:1,origenId:1,destinoId:2},{id:2,origenId:2,destinoId:3},{id:3,origenId:3,destinoId:1}[']'/],
 Vuelo:['['/]{id:1,codigo:'AND-102',salida:day(1,10),llegada:day(1,11),rutaId:1,avionId:1},{id:2,codigo:'SIE-318',salida:day(1,14),llegada:day(1,15),rutaId:2,avionId:2},{id:3,codigo:'AND-205',salida:day(2,9),llegada:day(2,10),rutaId:3,avionId:1},{id:4,codigo:'SIE-406',salida:day(3,16),llegada:day(3,17),rutaId:1,avionId:2}[']'/],

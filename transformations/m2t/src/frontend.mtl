/* Generated by Acceleo. Generic UI consumes generated fields and form templates. */
(function(){'use strict';
const model=FlightModel,$=s=>document.querySelector(s),all=s=>Array.from(document.querySelectorAll(s));
const esc=v=>String(v??'').replace(/['['/]&<>"'[']'/]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}['['/]c[']'/]));
const names={Aeropuerto:['['/]'Aeropuerto','Aeropuertos'[']'/],Aerolinea:['['/]'Aerolínea','Aerolíneas'[']'/],Avion:['['/]'Avión','Aviones'[']'/],Ruta:['['/]'Ruta','Rutas'[']'/],Vuelo:['['/]'Vuelo','Vuelos'[']'/],Pasajero:['['/]'Pasajero','Pasajeros'[']'/],Reserva:['['/]'Reserva','Reservas'[']'/],Boleto:['['/]'Boleto','Boletos'[']'/]};
const views={resumen:'Resumen',vuelos:'Vuelos',pasajeros:'Pasajeros',reservas:'Reservas',boletos:'Boletos',catalogos:'Catálogos'};
let storage=null;try{storage=localStorage;}catch(e){}let settings={mode:'demo',apiBase:'/api'};try{Object.assign(settings,JSON.parse(storage?.getItem('aero.connection')||'{}'));}catch(e){}
const demo=new FlightDemo(model,{storage});let data={},view='resumen',catalog='Aeropuerto',query='',origin='',destination='',reservationFilter='TODAS',toastTimer;
const spec=t=>model.entities.find(e=>e.name===t),rows=t=>data['['/]t[']'/]||['['/][']'/],find=(t,id)=>rows(t).find(r=>r.id===Number(id));
const date=v=>v?new Intl.DateTimeFormat('es-EC',{day:'2-digit',month:'short',year:'numeric'}).format(new Date(v)):'—',time=v=>v?new Intl.DateTimeFormat('es-EC',{hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(v)):'—';
const pill=s=>`<span class="pill ${s==='CANCELADA'?'gray':''}">${s==='CONFIRMADA'?'Confirmada':s==='CANCELADA'?'Cancelada':esc(s)}</span>`;
function toast(message,error=false){clearTimeout(toastTimer);const el=$('#toast');el.textContent=message;el.className=error?'error':'';el.hidden=false;toastTimer=setTimeout(()=>el.hidden=true,5000);}
function label(t,r){if(!r)return '—';if(t==='Aeropuerto')return `${r.codigo} · ${r.ciudad}`;if(t==='Aerolinea')return r.nombre;if(t==='Avion')return `${r.matricula} · ${r.capacidad} asientos`;if(t==='Ruta')return `${find('Aeropuerto',r.origenId)?.codigo||'—'} → ${find('Aeropuerto',r.destinoId)?.codigo||'—'}`;if(t==='Pasajero')return r.nombreCompleto;if(t==='Vuelo')return `${r.codigo} · ${label('Ruta',find('Ruta',r.rutaId))} · ${date(r.salida)} ${time(r.salida)}`;if(t==='Reserva')return `${r.localizador} · ${label('Pasajero',find('Pasajero',r.pasajeroId))} · asiento ${r.numeroAsiento}`;return r.numero||r.codigo||'#'+r.id;}
async function request(path,body){const response=await fetch(settings.apiBase.replace(/\/$/,'')+path,{method:body===undefined?'GET':'POST',headers:{'Content-Type':'application/json'},...(body===undefined?{}:{body:JSON.stringify(body)})});const payload=await response.json().catch(()=>({}));if(!response.ok)throw Error(payload.detail||'La operación no pudo completarse');return payload;}
async function refresh(){if(settings.mode==='demo')data=Object.fromEntries(model.entities.map(e=>['['/]e.name,demo.all(e.name)[']'/]));else data=Object.fromEntries(await Promise.all(model.entities.map(async e=>['['/]e.name,await request(e.path.replace(/^\/api/,''))[']'/])));$('#mode-label').textContent=settings.mode==='demo'?'Demostración local':'Backend conectado';$('#storage-label').textContent=settings.mode==='demo'?(demo.persistent?'Datos ficticios · guardados en este navegador':'Datos ficticios · temporales en esta sesión'):'Datos de la API · persistencia del backend';}
function heading(title,subtitle,action=''){return `<section class="page-heading"><div><span class="eyebrow">CENTRO DE OPERACIONES</span><h1>${title}</h1><p>${subtitle}</p></div>${action}</section>`;}
function createButton(t,text){return `<button class="button primary" data-create="${t}"><span>＋</span>${text||'Registrar '+names['['/]t[']'/]['['/]0[']'/].toLowerCase()}</button>`;}
const upcoming=()=>rows('Vuelo').filter(v=>new Date(v.salida)>new Date()).sort((a,b)=>new Date(a.salida)-new Date(b.salida));
function table(head,body,count){return `<div class="table-scroll"><table><thead><tr>${head.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${body||`<tr><td colspan="${head.length}"><div class="empty"><div class="empty-icon">◇</div><h3>No hay registros para mostrar</h3><p>Prueba otro filtro o registra el primer elemento.</p></div></td></tr>`}</tbody></table></div><div class="table-footer"><span>${count} ${count===1?'registro':'registros'}</span><span>Horarios en tu zona local</span></div>`;}
function flightRows(flights,compact=false){return flights.map(v=>{const route=find('Ruta',v.rutaId),plane=find('Avion',v.avionId),from=find('Aeropuerto',route?.origenId),to=find('Aeropuerto',route?.destinoId),available=new Date(v.salida)>new Date()&&v.cuposDisponibles>0;return `<tr><td><div class="flight-cell"><span class="plane-mini">↗</span><div><span class="cell-primary">${esc(v.codigo)}</span><span class="cell-sub">${esc(label('Aerolinea',find('Aerolinea',plane?.aerolineaId)))}</span></div></div></td><td><span class="route-inline">${esc(from?.codigo)} <span class="route-arrow">→</span> ${esc(to?.codigo)}</span><span class="cell-sub">${esc(from?.ciudad)} · ${esc(to?.ciudad)}</span></td><td><span class="cell-primary">${time(v.salida)}</span><span class="cell-sub">${date(v.salida)}</span></td>${compact?'':`<td>${esc(plane?.matricula)}<span class="cell-sub">${plane?.capacidad||0} asientos</span></td>`}<td><span class="pill ${available?'':'gray'}">${available?'Disponible':new Date(v.salida)<=new Date()?'Salida alcanzada':'Completo'}</span><span class="cell-sub">${v.cuposDisponibles} cupos libres</span></td><td><button class="button secondary small" data-book="${v.id}" ${available?'':'disabled'}>Reservar</button></td></tr>`;}).join('');}
function dashboard(){const flights=upcoming(),active=rows('Reserva').filter(r=>r.estado==='CONFIRMADA'),capacity=rows('Vuelo').reduce((n,v)=>n+(find('Avion',v.avionId)?.capacidad||0),0);const stats=['['/]['['/]'Vuelos programados',flights.length,'↗','Salidas próximas'[']'/],['['/]'Pasajeros registrados',rows('Pasajero').length,'♙','Listos para viajar'[']'/],['['/]'Reservas confirmadas',active.length,'▤',`${capacity?Math.round(active.length/capacity*100):0}% de ocupación total`[']'/],['['/]'Boletos emitidos',rows('Boleto').length,'▱','Reservas con boleto'[']'/][']'/];let next='';if(flights['['/]0[']'/]){const f=flights['['/]0[']'/],r=find('Ruta',f.rutaId),a=find('Aeropuerto',r?.origenId),b=find('Aeropuerto',r?.destinoId);next=`<div class="route-card"><div class="flight-caption"><span>PRÓXIMA SALIDA</span><small>${esc(f.codigo)}</small></div><div class="route-visual"><div><div class="airport-code">${esc(a?.codigo)}</div><div class="airport-city">${esc(a?.ciudad)}</div></div><div class="route-dashes"><span>✈</span></div><div><div class="airport-code">${esc(b?.codigo)}</div><div class="airport-city">${esc(b?.ciudad)}</div></div></div><div class="route-time"><span>${time(f.salida)} <small>Salida</small></span><span>${time(f.llegada)} <small>Llegada</small></span></div><button class="button" data-book="${f.id}">Reservar en este vuelo →</button></div>`;}
return heading('Una vista clara de tu operación','Programa vuelos y acompaña cada viaje, desde la reserva hasta el boleto.',createButton('Vuelo','Programar vuelo'))+`<div class="metrics">${stats.map(s=>`<div class="metric"><div class="metric-top">${s['['/]0[']'/]}<span class="metric-icon">${s['['/]2[']'/]}</span></div><div class="metric-value">${s['['/]1[']'/]}</div><div class="metric-bottom"><b>●</b> ${s['['/]3[']'/]}</div></div>`).join('')}</div><div class="content-grid"><section class="panel"><div class="panel-heading"><div><h3>Próximos vuelos</h3><p>La programación que viene, de un vistazo.</p></div><button class="text-button" data-go="vuelos">Ver todos los vuelos →</button></div>${table(['['/]'Vuelo','Ruta','Salida','Estado',''[']'/],flightRows(flights.slice(0,5),true),flights.length)}</section><aside class="right-rail">${next}<section class="panel activity"><h3>Últimas reservas</h3>${rows('Reserva').slice().reverse().slice(0,3).map(r=>`<div class="activity-item"><span class="activity-dot">${r.estado==='CONFIRMADA'?'✓':'−'}</span><div><p>${esc(label('Pasajero',find('Pasajero',r.pasajeroId)))}</p><small>${esc(find('Vuelo',r.vueloId)?.codigo)} · asiento ${r.numeroAsiento}<br>${r.estado==='CONFIRMADA'?'Reserva confirmada':'Reserva cancelada'}</small></div></div>`).join('')||'<p class="muted">Aquí aparecerán tus nuevas reservas.</p>'}</section></aside></div>`;}
function toolbar(t){return `<div class="toolbar"><label class="search-wrap"><span>⌕</span><input id="search" aria-label="Buscar registros" placeholder="Buscar ${names['['/]t[']'/]['['/]1[']'/].toLowerCase()}…" value="${esc(query)}"></label>${t==='Vuelo'?`<select id="origin-filter" class="filter-select" aria-label="Filtrar por origen"><option value="">Todos los orígenes</option>${rows('Aeropuerto').map(a=>`<option value="${a.id}" ${origin===String(a.id)?'selected':''}>${esc(label('Aeropuerto',a))}</option>`).join('')}</select><select id="destination-filter" class="filter-select" aria-label="Filtrar por destino"><option value="">Todos los destinos</option>${rows('Aeropuerto').map(a=>`<option value="${a.id}" ${destination===String(a.id)?'selected':''}>${esc(label('Aeropuerto',a))}</option>`).join('')}</select>`:''}</div>`;}
function matches(t,r){return !query||['['/]...Object.values(r),label(t,r),...spec(t).relations.map(ref=>label(ref.target,find(ref.target,r['['/]ref.name+'Id'[']'/])))[']'/].join(' ').toLocaleLowerCase().includes(query.toLocaleLowerCase());}
function genericTable(t){const e=spec(t),fields=e.fields.filter(f=>!f.primaryKey),items=rows(t).filter(r=>matches(t,r)&&(t!=='Reserva'||reservationFilter==='TODAS'||r.estado===reservationFilter));const body=items.map(r=>`<tr>${fields.map(f=>`<td>${f.name==='estado'?pill(r['['/]f.name[']'/]):f.name==='numeroAsiento'?`<span class="seat-chip">${r['['/]f.name[']'/]}</span>`:f.type==='OFFSET_DATE_TIME'?`${date(r['['/]f.name[']'/])}<span class="cell-sub">${time(r['['/]f.name[']'/])}</span>`:f.name==='numero'||f.name==='localizador'?`<span class="cell-primary">${esc(r['['/]f.name[']'/])}</span>`:esc(r['['/]f.name[']'/]??'—')}</td>`).join('')}${e.relations.map(ref=>`<td>${esc(label(ref.target,find(ref.target,r['['/]ref.name+'Id'[']'/])))}</td>`).join('')}${t==='Boleto'?`<td><span class="seat-chip">${r.numeroAsiento}</span></td>`:''}<td>${t==='Reserva'?(r.boletoId?`<button class="button secondary small" data-ticket="${r.boletoId}">Ver boleto</button>`:r.estado==='CONFIRMADA'?`<button class="button primary small" data-issue="${r.id}">Emitir boleto</button> <button class="text-button" data-cancel-reservation="${r.id}">Cancelar</button>`:'<span class="muted">Historial</span>'):t==='Boleto'?`<button class="button secondary small" data-ticket="${r.id}">Ver boleto ↗</button>`:''}</td></tr>`).join('');return table(['['/]...fields.map(f=>f.label),...e.relations.map(r=>r.label),...(t==='Boleto'?['['/]'Asiento'[']'/]:['['/][']'/]),''[']'/],body,items.length);}
function listView(t){if(t==='Vuelo'){const items=rows(t).filter(v=>matches(t,v)&&(!origin||String(v.origenId)===origin)&&(!destination||String(v.destinoId)===destination)).sort((a,b)=>new Date(a.salida)-new Date(b.salida));return heading('Vuelos','Organiza la programación y encuentra el próximo viaje.',createButton(t,'Programar vuelo'))+`<section class="panel">${toolbar(t)}${table(['['/]'Vuelo','Ruta','Salida','Avión','Estado',''[']'/],flightRows(items),items.length)}</section>`;}const intro={Pasajero:'La información de quienes viajan contigo.',Reserva:'Cada pasajero, su vuelo y su asiento en un mismo lugar.',Boleto:'Emite y consulta los boletos de las reservas confirmadas.'};return heading(names['['/]t[']'/]['['/]1[']'/],intro['['/]t[']'/],createButton(t,t==='Reserva'?'Nueva reserva':t==='Boleto'?'Emitir boleto':'Registrar pasajero'))+(t==='Reserva'?`<div class="segmented">${['['/]'TODAS','CONFIRMADA','CANCELADA'[']'/].map(s=>`<button data-reservation-filter="${s}" class="${reservationFilter===s?'selected':''}">${s==='TODAS'?'Todas':s==='CONFIRMADA'?'Confirmadas':'Canceladas'}</button>`).join('')}</div>`:'')+`<section class="panel">${toolbar(t)}${genericTable(t)}</section>`;}
function catalogs(){return heading('Catálogos','Prepara los aeropuertos, aerolíneas, aviones y rutas de tu operación.',createButton(catalog))+`<div class="segmented">${['['/]'Aeropuerto','Aerolinea','Avion','Ruta'[']'/].map(t=>`<button data-catalog="${t}" class="${catalog===t?'selected':''}">${names['['/]t[']'/]['['/]1[']'/]}</button>`).join('')}</div><section class="panel">${toolbar(catalog)}${genericTable(catalog)}</section>`;}

function render(){all('#navigation button').forEach(b=>{b.classList.toggle('active',b.dataset.view===view);b.setAttribute('aria-label',views['['/]b.dataset.view[']'/]);b.title=views['['/]b.dataset.view[']'/];b.setAttribute('aria-current',b.dataset.view===view?'page':'false');});$('#crumb').textContent=views['['/]view[']'/];document.title=views['['/]view[']'/]+' · Aero';$('#workspace').innerHTML=view==='resumen'?dashboard():view==='catalogos'?catalogs():listView({vuelos:'Vuelo',pasajeros:'Pasajero',reservas:'Reserva',boletos:'Boleto'}['['/]view[']'/]);}
function go(next){if(!(next in views))return;view=next;query='';origin='';destination='';render();history.replaceState(null,'','#'+view);}
async function mutate(fn,message){try{const value=await fn();await refresh();render();toast(message);return value;}catch(e){toast(e.message,true);return null;}}
function openForm(t,preset){const template=$('#form-'+t);if(!template)return;$('#dialog-eyebrow').textContent=t==='Reserva'?'RESERVA DE VUELO':t==='Boleto'?'EMISIÓN DE BOLETO':'NUEVO REGISTRO';$('#dialog-title').textContent=t==='Reserva'?'Nueva reserva':t==='Boleto'?'Emitir boleto':t==='Vuelo'?'Programar vuelo':'Registrar '+names['['/]t[']'/]['['/]0[']'/].toLowerCase();$('#dialog-body').replaceChildren(template.content.cloneNode(true));const form=$('#dialog-body form');form.querySelectorAll('select['['/]data-reference[']'/]').forEach(select=>{const target=select.dataset.reference;let options=rows(target);if(t==='Reserva'&&target==='Vuelo')options=options.filter(v=>new Date(v.salida)>new Date()&&v.cuposDisponibles>0);if(t==='Boleto'&&target==='Reserva')options=options.filter(r=>r.estado==='CONFIRMADA'&&!r.boletoId&&new Date(find('Vuelo',r.vueloId)?.salida)>new Date());select.innerHTML='<option value="">Selecciona una opción</option>'+options.map(r=>`<option value="${r.id}">${esc(label(target,r))}</option>`).join('');if(preset&&select.name==='vueloId')select.value=String(preset);});form.querySelector('['['/]data-submit[']'/]').textContent=t==='Reserva'?'Confirmar reserva':t==='Boleto'?'Emitir boleto':t==='Vuelo'?'Programar vuelo':'Guardar registro';const context=form.querySelector('.form-context');function updateContext(){if(t==='Reserva'){const f=find('Vuelo',form.elements.vueloId.value);context.hidden=false;context.textContent=f?`${f.cuposDisponibles} cupos disponibles. El asiento se asignará automáticamente al confirmar.`:'Selecciona un vuelo y un pasajero. El asiento se asigna automáticamente.';}if(t==='Boleto'){context.hidden=false;context.textContent='El boleto conserva el asiento de la reserva; no ocupa un cupo adicional.';}}updateContext();form.addEventListener('change',updateContext);form.querySelector('['['/]data-cancel[']'/]').onclick=()=>$('#editor').close();form.onsubmit=async ev=>{ev.preventDefault();const button=form.querySelector('['['/]data-submit[']'/]'),error=form.querySelector('.form-error');button.disabled=true;error.hidden=true;try{const input=Object.fromEntries(new FormData(form));for(const f of spec(t).fields)if(input['['/]f.name[']'/]&&['['/]'INTEGER','LONG'[']'/].includes(f.type))input['['/]f.name[']'/]=Number(input['['/]f.name[']'/]);else if(input['['/]f.name[']'/]&&f.type==='OFFSET_DATE_TIME')input['['/]f.name[']'/]=new Date(input['['/]f.name[']'/]).toISOString();for(const ref of spec(t).relations)input['['/]ref.name+'Id'[']'/]=input['['/]ref.name+'Id'[']'/]?Number(input['['/]ref.name+'Id'[']'/]):null;const value=settings.mode==='demo'?demo.create(t,input):await request(spec(t).path.replace(/^\/api/,'')+(t==='Boleto'?'/reserva/'+input.reservaId:''),t==='Boleto'?{}:input);await refresh();$('#editor').close();if(t==='Boleto'){go('boletos');showTicket(value.id);}else{go(t==='Reserva'?'reservas':t==='Vuelo'?'vuelos':t==='Pasajero'?'pasajeros':'catalogos');if(['['/]'Aeropuerto','Aerolinea','Avion','Ruta'[']'/].includes(t)){catalog=t;render();}}toast(t==='Reserva'?`Reserva confirmada · asiento ${value.numeroAsiento}`:t==='Boleto'?'Boleto emitido correctamente':'Registro guardado correctamente');}catch(e){error.textContent=e.message;error.hidden=false;}finally{button.disabled=false;}};$('#editor').showModal();}
function showTicket(id){const b=find('Boleto',id);if(!b)return;const r=find('Reserva',b.reservaId),f=find('Vuelo',r?.vueloId),route=find('Ruta',f?.rutaId),a=find('Aeropuerto',route?.origenId),z=find('Aeropuerto',route?.destinoId),p=find('Pasajero',r?.pasajeroId);$('#dialog-eyebrow').textContent='DOCUMENTO DE RESERVA';$('#dialog-title').textContent='Tu boleto de vuelo';$('#dialog-body').innerHTML=`<article class="ticket"><div class="ticket-top"><strong>aero.</strong><span>${esc(b.numero)}</span></div><div class="ticket-body"><div class="ticket-route"><div>${esc(a?.codigo)}<span class="cell-sub">${esc(a?.ciudad)}</span></div><span class="route-arrow">✈</span><div>${esc(z?.codigo)}<span class="cell-sub">${esc(z?.ciudad)}</span></div></div><div class="ticket-grid">${['['/]['['/]'PASAJERO',p?.nombreCompleto[']'/],['['/]'VUELO',f?.codigo[']'/],['['/]'SALIDA',date(f?.salida)+' · '+time(f?.salida)[']'/],['['/]'ASIENTO',b.numeroAsiento[']'/],['['/]'RESERVA',r?.localizador[']'/],['['/]'EMITIDO',date(b.emitidoEn)[']'/][']'/].map(s=>`<div><small>${s['['/]0[']'/]}</small><strong>${esc(s['['/]1[']'/])}</strong></div>`).join('')}</div><p class="ticket-foot">Constancia de reserva · ${settings.mode==='demo'?'Demostración con datos ficticios':'Información del sistema de vuelos'}. No es una tarjeta de embarque.</p></div></article><div class="dialog-actions"><button class="button secondary" id="close-ticket">Cerrar</button><button class="button primary" id="print-ticket">Imprimir boleto</button></div>`;$('#close-ticket').onclick=()=>$('#editor').close();$('#print-ticket').onclick=()=>window.print();if(!$('#editor').open)$('#editor').showModal();}
document.addEventListener('click',async ev=>{const b=ev.target.closest('button');if(!b)return;if(b.dataset.view)go(b.dataset.view);if(b.dataset.go)go(b.dataset.go);if(b.dataset.create)openForm(b.dataset.create);if(b.dataset.book)openForm('Reserva',Number(b.dataset.book));if(b.dataset.catalog){catalog=b.dataset.catalog;query='';render();}if(b.dataset.reservationFilter){reservationFilter=b.dataset.reservationFilter;render();}if(b.dataset.ticket)showTicket(Number(b.dataset.ticket));if(b.dataset.issue){const value=await mutate(()=>settings.mode==='demo'?demo.issue(Number(b.dataset.issue)):request('/boletos/reserva/'+b.dataset.issue,{}),'Boleto emitido correctamente');if(value)showTicket(value.id);}if(b.dataset.cancelReservation){const id=Number(b.dataset.cancelReservation);$('#dialog-title').textContent='Cancelar reserva';$('#dialog-eyebrow').textContent='GESTIÓN DE RESERVAS';$('#dialog-body').innerHTML='<p class="muted">Se liberará el asiento y se conservará la reserva en el historial.</p><div class="dialog-actions"><button class="button secondary" id="keep-reservation">Conservar reserva</button><button class="button primary" id="confirm-cancel">Confirmar cancelación</button></div>';$('#keep-reservation').onclick=()=>$('#editor').close();$('#confirm-cancel').onclick=async()=>{const value=await mutate(()=>settings.mode==='demo'?demo.cancel(id):request('/reservas/'+id+'/cancelacion',{}),'Reserva cancelada · asiento disponible');if(value)$('#editor').close();};$('#editor').showModal();}});
document.addEventListener('input',ev=>{if(ev.target.id==='search'){const start=ev.target.selectionStart;query=ev.target.value;render();$('#search')?.focus();$('#search')?.setSelectionRange(start,start);}});document.addEventListener('change',ev=>{if(ev.target.id==='origin-filter'){origin=ev.target.value;render();}if(ev.target.id==='destination-filter'){destination=ev.target.value;render();}});
$('#close-editor').onclick=()=>$('#editor').close();all('['['/]data-close-settings[']'/]').forEach(b=>b.onclick=()=>$('#settings').close());$('#connection').onclick=()=>{const form=$('#settings-form');form.elements.mode.value=settings.mode;form.elements.apiBase.value=settings.apiBase;form.querySelector('.form-error').hidden=true;$('#settings').showModal();};$('#settings-form').onsubmit=async ev=>{ev.preventDefault();const form=ev.target,previous={...settings},button=form.querySelector('button['['/]type=submit[']'/]');button.disabled=true;try{const next=Object.fromEntries(new FormData(form));settings={mode:next.mode,apiBase:next.apiBase.trim()||'/api'};await refresh();try{storage?.setItem('aero.connection',JSON.stringify(settings));}catch(e){}render();$('#settings').close();toast(settings.mode==='demo'?'Demostración local activa':'Backend conectado');}catch(e){settings=previous;const error=form.querySelector('.form-error');error.textContent='No se pudo conectar con la API. Comprueba el backend o selecciona Demostración local.';error.hidden=false;}finally{button.disabled=false;}};
$('#reset-demo').onclick=()=>{if(settings.mode!=='demo'){toast('Cambia al modo de demostración para restablecer sus datos',true);return;}$('#settings').close();$('#dialog-title').textContent='Restablecer demostración';$('#dialog-eyebrow').textContent='DATOS LOCALES';$('#dialog-body').innerHTML='<p class="muted">Se reemplazarán los registros locales por los ejemplos iniciales. La API y la base de datos no se modifican.</p><div class="dialog-actions"><button class="button secondary" id="no-reset">Conservar datos</button><button class="button primary" id="confirm-reset">Restablecer ejemplos</button></div>';$('#no-reset').onclick=()=>$('#editor').close();$('#confirm-reset').onclick=async()=>{demo.reset();await refresh();$('#editor').close();go('resumen');toast('Datos de demostración restablecidos');};$('#editor').showModal();};
(async()=>{view=location.hash.slice(1) in views?location.hash.slice(1):'resumen';try{await refresh();render();}catch(e){$('#workspace').innerHTML=heading('Conecta tu operación','La API no está disponible en este momento.')+'<div class="error-panel"><h3>No se pudo cargar la información</h3><p>Abre «Origen de los datos» en la barra superior y selecciona Demostración local para recorrer las pantallas sin el backend.</p></div>';$('#mode-label').textContent='Revisar conexión';}})();
})();

[/file]
[/template]

[query public label(s : String) : String =
 if s='codigo' then 'Código' else if s='nombreCompleto' then 'Nombre completo' else
 if s='matricula' then 'Matrícula' else if s='capacidad' then 'Capacidad' else
 if s='numeroAsiento' then 'Asiento' else if s='creadaEn' then 'Creación' else
 if s='emitidoEn' then 'Emisión' else if s='aerolinea' then 'Aerolínea' else
 if s='avion' then 'Avión' else s.toUpperFirst() endif endif endif endif endif endif endif endif endif /]
[query public inputType(a : Attribute) : String =
 if a.javaType=JavaType::INTEGER or a.javaType=JavaType::LONG then 'number' else
 if a.javaType=JavaType::OFFSET_DATE_TIME then 'datetime-local' else 'text' endif endif /]
